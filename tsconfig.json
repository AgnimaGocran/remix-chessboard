{
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"target": "ESNext",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/ui",
		"noEmit": true
	},
	"exclude": ["node_modules"]
}